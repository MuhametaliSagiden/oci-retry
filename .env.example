# ---- OCI auth ----
# Путь к ~/.oci/config; в CI файл собирается из секретов.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# ---- Где запускаем ----
# Пусто -> корневой компартмент (он же tenancy OCID).
OCI_COMPARTMENT_ID=
# Пусто -> скрипт сам создаст VCN/сабнет и откроет порты.
OCI_SUBNET_ID=
# Пусто -> сам найдёт свежий Ubuntu 24.04 под архитектуру шейпа.
OCI_IMAGE_ID=
# Пусто -> перебирать все AD региона. Иначе "AD-1,AD-2".
OCI_AVAILABILITY_DOMAINS=

# ---- Что запускаем ----
# shape:ocpus:memory_gb через запятую, по приоритету.
# Always Free ARM с 15.06.2026: 2 OCPU / 12 GB.
OCI_SHAPE_PLAN=VM.Standard.A1.Flex:2:12
OCI_BOOT_VOLUME_GB=100
OCI_DISPLAY_NAME=torrserver
OCI_SSH_PUBLIC_KEY=

# ---- Домен и TorrServer ----
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Свой домен вместо DuckDNS (A-запись должна вести на IP инстанса).
TS_DOMAIN=
TS_USER=lampa
TS_PASS=
TS_CACHE_GB=2
TS_PEER_PORT=32000

# ---- Тайминги ----
MIN_DELAY=30
MAX_DELAY=90
TOO_MANY_REQUESTS_DELAY=120
# 0 = без ограничений (для локального бесконечного запуска).
MAX_ATTEMPTS=0
MAX_RUNTIME_SECONDS=0

# ---- Telegram (опционально) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
